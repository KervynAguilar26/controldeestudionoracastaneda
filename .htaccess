# ============================================================
# Seguridad - Sistema Escuela Nora Castañeda
# ============================================================

# 1) No mostrar listados de directorios (vendor, libs, assets, uploads, etc.)
Options -Indexes

# 2) Cabeceras de seguridad en todas las respuestas
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# 3) Bloquear acceso web directo a código interno (includes, vendor, libs)
#    (config/ y logs/ ya tienen su propio .htaccess con "Require all denied")
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|vendor|libs)/ - [F,L]
</IfModule>
